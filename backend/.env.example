# In Render, set this to the Vercel origin (no path); comma-separated origins are supported.
FRONTEND_ORIGIN=http://localhost:3000
OPENAI_API_KEY=
SKETCH_PROVIDER=openai
# Demo storage: local is the default and needs no external account. Supabase is optional.
SKETCH_STORAGE_BACKEND=local
# Optional future Supabase configuration (backend only). Leave blank for the demo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sketch-images
